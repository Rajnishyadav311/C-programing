#include<stdio.h>
int main(){
    int n ;
    printf("Enter the size of matrix : ");
    scanf("%d" ,&n);
    int m;
    printf("Enter the size of matrix : ");
    scanf("%d" ,&m);
    int arr[n][m] ,brr[m][n];
     for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            scanf("%d", &arr[i][j]);
        }
    }

     for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
           brr[j][i]=arr[i][j];
        }
    }


     for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            printf("%d", brr[i][j]);
        }
    }
}